# ===================================
# LOCAL DEVELOPMENT CONFIGURATION
# ===================================
# Copy this file to .env and update values

# Server Configuration
PORT=4000

# Database Configuration
# Local: Use postgres on localhost
# Docker: Use postgres://postgres:postgres@postgres:5432/coding_platform?sslmode=disable
DATABASE_URL=postgres://username:password@localhost:5432/coding_platform?sslmode=disable

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:5173,https://app.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# RabbitMQ Configuration (for async code execution queue)
# Local: Use localhost
# Docker: Use amqp://guest:guest@rabbitmq:5672/
# Production: Use CloudAMQP URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# Worker API Configuration
WORKER_API_KEY=your-secure-worker-api-key-change-this-in-production

# API Base URL (for worker-to-server communication)
# Local: http://localhost:4000
# Docker: http://api:4000
API_BASE_URL=http://localhost:4000

# Frontend Configuration (for email verification links)
FRONTEND_URL=http://localhost:5173

# Environment
ENV=development

# ===================================
# DEPLOYMENT NOTES
# ===================================
#
# RENDER DEPLOYMENT:
# ------------------
# API Server requires:
#   - DATABASE_URL (use Render PostgreSQL Internal URL)
#   - RABBITMQ_URL (use CloudAMQP URL)
#   - JWT_SECRET, JWT_REFRESH_SECRET (generate with: openssl rand -hex 32)
#   - WORKER_API_KEY (generate with: openssl rand -hex 32)
#   - API_BASE_URL (your Render API service URL)
#   - FRONTEND_URL (your frontend deployment URL)
#
# Worker requires:
#   - RABBITMQ_URL (same as API server)
#   - WORKER_API_KEY (SAME as API server)
#   - API_BASE_URL (your Render API service URL)
#   - NOTE: Worker does NOT need DATABASE_URL (uses API)
#
# IMPORTANT: Worker cannot run on Render due to Docker-in-Docker limitations.
# Deploy worker on VPS (DigitalOcean, Linode, AWS EC2) instead.
# See DEPLOY.md for detailed instructions.
#
# DOCKER COMPOSE:
# ---------------
# Uses values from docker-compose.yml, no .env needed
# Database: postgres://postgres:postgres@postgres:5432/coding_platform?sslmode=disable
# RabbitMQ: amqp://guest:guest@rabbitmq:5672/
#
# MIGRATIONS:
# -----------
# Migrations run AUTOMATICALLY when API server starts
# No manual "make migrate-up" needed in production
# Migrations are embedded in Docker image
