# ===================================
# DOCKER COMPOSE CONFIGURATION
# ===================================
# Use this for running with docker-compose
# Copy to .env when using docker-compose up

# Server Configuration
PORT=4000

# Database Configuration (Docker service name)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/coding_platform?sslmode=disable

# RabbitMQ Configuration (Docker service name)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT Configuration
JWT_SECRET=your-dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-dev-refresh-secret-change-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# SMTP Configuration (Optional for local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# Worker API Configuration
WORKER_API_KEY=dev-worker-api-key-change-in-production

# API Base URL (Docker service name)
API_BASE_URL=http://api:4000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Environment
ENV=development
